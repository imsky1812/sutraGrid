# Copy to backend-mock/.env and fill in real values. .env is gitignored.

# Port the mock backend listens on.
PORT=3000

# Comma-separated codes that authorise a client to stream as an emergency
# vehicle (ambulance / police / fire). A login requesting emergency status
# without one of these is rejected with 403.
EMERGENCY_CODES=change-me-emergency-code

# Shared secret the operator dashboard presents on /dashboard/stream.
# Must match MAPS/OPERATOR_KEY in admin-dashboard/config.js.
OPERATOR_KEY=change-me-operator-key
