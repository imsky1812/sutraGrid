# Expo SDK 57 pins react@19.2.3, while expo-router pulls react-dom@19.2.8
# transitively (via Radix, for web support), which declares peer react@^19.2.8.
# That skew is upstream, not something this project introduced.
#
# react-dom is only used by the web target; this app builds an Android APK, so
# the unsatisfied peer has no effect on what ships. Set here rather than passed
# as a flag so every install behaves the same way.
legacy-peer-deps=true
