# Copy to mobile/.env and fill in. mobile/.env is gitignored.
#
# Both values are inlined into the app bundle at build time. That is fine for
# these two - the anon key is publishable and constrained by row-level security.
# Never add a service_role key here.
#
# There is no maps key: tiles come from OpenFreeMap and routing from OSRM,
# neither of which requires one.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
