# Copy to apk/.env and fill in real values. apk/.env is gitignored.

# Google Maps API key used by the Maps SDK and the Directions call.
# Restrict it in Google Cloud Console to your Android app's package name and
# signing SHA-1 - it ships inside the APK and is not secret.
MAPS_API_KEY=your-android-maps-api-key

# host:port of the mock backend.
#   10.0.2.2:3000        Android emulator reaching the host machine
#   192.168.x.x:3000     physical device on the same LAN
BACKEND_HOST=10.0.2.2:3000
