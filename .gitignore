# Gradle
.gradle/
build/
app/build/

# Local properties
local.properties

# Secrets — never commit these. See the matching .example files.
.env
.env.local
admin-dashboard/config.js

# IDE
.idea/
*.iml

# Node / JS / Web
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo app
mobile/node_modules/
mobile/.expo/
mobile/android/
mobile/ios/
mobile/.env

# Built APKs are artifacts, not source
*.apk

# Staged copy of the dashboard for EAS Hosting
mobile/dashboard-dist/

# Firebase service-account keys are private credentials: they belong in EAS
# (expo.dev > Credentials > FCM V1 service account key), never in the repo.
# google-services.json is different - public identifiers - and may be committed.
*firebase-adminsdk*.json
*service-account*.json

# Credentials the tools sign in with. Never commit.
tools/.env
