# Secrets for Supabase Edge Functions.
#
# These are NOT read from a committed file at runtime. Set them on the project:
#   npx supabase secrets set GOOGLE_DIRECTIONS_KEY=...
#
# This file documents which secrets the functions expect. supabase/.env is
# gitignored; never put a real key in this example.

# Google Directions API key, used only by the `directions` Edge Function.
# It deliberately never ships in the APK - that is the whole point of the proxy.
GOOGLE_DIRECTIONS_KEY=your-directions-api-key
